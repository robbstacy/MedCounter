<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Medication data stays off Google cloud backup (privacy policy);
     direct device-to-device transfer to a new phone still carries it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
