<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MD5DeepGui</RootNamespace>
    <AssemblyName>MD5DeepGUI</AssemblyName>
    <!-- Assembly metadata (including the credit to Jesse Kornblum) lives in
         src/Program.cs, so suppress the SDK's auto-generated attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
